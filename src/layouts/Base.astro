---
import '../styles/global.css';
import { t, type Lang } from '../i18n/ui';

interface Props { title: string; lang: Lang; description?: string; }
const { title, lang, description } = Astro.props;
const other = lang === 'en' ? 'es' : 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(new RegExp(`^${base}`), '').replace(/^\/(en|es)/, '');
const u = (p: string) => `${base}${p}`;
const here = (p: string) => Astro.url.pathname.replace(/\/$/, '') === u(`/${lang}${p}`).replace(/\/$/, '');
const navCls = (p: string) => here(p)
  ? 'text-[color:var(--color-brand-600)] font-medium underline underline-offset-4 decoration-2'
  : 'hover:text-[color:var(--color-brand-600)]';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="tm-track-endpoint" content={import.meta.env.PUBLIC_TRACK_ENDPOINT ?? ''} />
    <link rel="alternate" hreflang={other} href={u(`/${other}${path}`)} />
    <link rel="alternate" hreflang="x-default" href={u(`/en${path}`)} />
    <!--
      El rastro de la convocatoria.

      Un solo sitio donde se arma el evento, para que la campana viaje con el:
      los utm llegan en la URL del anuncio, se guardan en la sesion y se pegan
      a TODO lo que pase despues. Sin eso sabriamos cuanta gente llego, pero no
      de donde vino la que ademas postulo, que es la unica cifra que decide
      donde publicar la proxima vez.

      Una visita por sesion, no por pagina: medir interes no justifica un goteo
      de peticiones navegando.
    -->
    <script is:inline>
      (() => {
        const endpoint = document.querySelector('meta[name="tm-track-endpoint"]')?.content || '';
        const CAMPOS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
        const leer = (k) => { try { return sessionStorage.getItem(k); } catch { return null; } };
        const guardar = (k, v) => { try { sessionStorage.setItem(k, v); } catch {} };

        const q = new URLSearchParams(location.search);
        const deLaUrl = {};
        CAMPOS.forEach((k) => { const v = q.get(k); if (v) deLaUrl[k] = String(v).slice(0, 80); });

        let utm = null;
        if (Object.keys(deLaUrl).length) {
          utm = deLaUrl;
          guardar('tm_utm', JSON.stringify(utm));
        } else {
          try { utm = JSON.parse(leer('tm_utm') || 'null'); } catch { utm = null; }
        }

        window.tmTrack = (evento, extra = {}) => {
          if (!endpoint) return;
          try {
            fetch(endpoint, {
              method: 'POST', mode: 'no-cors',
              headers: { 'Content-Type': 'text/plain;charset=utf-8' },
              body: JSON.stringify({
                event: evento, lang: document.documentElement.lang,
                path: location.pathname, ref: document.referrer || null,
                ts: new Date().toISOString(), ...(utm || {}), ...extra,
              }),
            });
          } catch { /* que no se note nunca en la pagina */ }
        };

        if (!leer('tm_visita')) { guardar('tm_visita', '1'); window.tmTrack('visita'); }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-zinc-200 bg-white">
      <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center gap-6 text-sm">
        <a href={u(`/${lang}/`)} class="font-bold text-[color:var(--color-brand-600)]">TailorMind</a>
        <a href={u(`/${lang}/process/`)} class={navCls('/process/')}>{t(lang,'nav.process')}</a>
        <a href={u(`/${lang}/role/`)} class={navCls('/role/')}>{t(lang,'nav.role')}</a>
        <a href={u(`/${lang}/flow/`)} class={navCls('/flow/')}>{t(lang,'nav.flow')}</a>
        <a href={u(`/${lang}/assessment/`)} class={navCls('/assessment/')}>{t(lang,'nav.assessment')}</a>
        <a href={u(`/${lang}/take-home/`)} class={navCls('/take-home/')}>{t(lang,'nav.takehome')}</a>
        <a href={u(`/${lang}/apply/`)} class="ml-auto px-3 py-1.5 rounded bg-[color:var(--color-brand-600)] text-white">{t(lang,'nav.apply')}</a>
        <a href={u(`/${other}${path}`)} class="text-xs text-zinc-500">{other.toUpperCase()}</a>
      </nav>
    </header>
    <main class="max-w-5xl mx-auto px-4 py-10 flex-1 w-full prose prose-zinc">
      <slot />
    </main>
    <footer class="border-t border-zinc-200 bg-white text-sm text-zinc-500">
      <div class="max-w-5xl mx-auto px-4 py-6 flex gap-4">
        <span>© TailorMind</span>
        <a href={u(`/${lang}/privacy/`)}>{t(lang,'nav.privacy')}</a>
        <a href={u(`/llm.txt`)}>llm.txt</a>
      </div>
    </footer>
  </body>
</html>
