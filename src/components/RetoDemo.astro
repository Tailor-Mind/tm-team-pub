---
/**
 * El guiño al reto: un trozo jugable del ejercicio, en la propia web.
 *
 * Usa los mismos números que `src/motor.lua` del armazón — gravedad 1800,
 * velocidad 260, impulso 620 — así que lo que se siente aquí es lo que se
 * siente allí. No es una animación decorativa: es el ejercicio en pequeño,
 * con los requisitos apareciendo mientras juegas y el último llegando cuando
 * ya no da tiempo.
 *
 * Mide curiosidad, no habilidad: si lo jugaste, cuánto, y si te picó lo
 * suficiente como para abrir el código. Nada de eso puntúa en el proceso.
 */
const { lang = 'es' } = Astro.props;

const copy = lang === 'es'
  ? {
      titulo: 'Así se siente el reto',
      sub: 'Muévete con las flechas, salta con espacio. Los requisitos van llegando solos — igual que en la prueba de verdad.',
      jugar: 'Clic aquí para jugar',
      gira: 'Gíralo: en horizontal se juega mucho mejor.',
      tactil: 'Muévete con ‹ ›, salta con el botón de la derecha.',
      codigo: 'Ver el código de esto',
      aviso: 'Qué medimos aquí',
      reqs: [
        { t: 0, id: 'R-01', txt: 'Un personaje que corre y salta. No atraviesa el suelo.' },
        { t: 12, id: 'R-10', txt: 'Monedas: recogerlas suma, y el marcador se ve siempre.' },
        { t: 26, id: 'R-30', txt: 'El nivel debe respetar el modo silencioso del jugador.', trampa: 'Ese término no existe. Preguntar o dejar el supuesto por escrito es la respuesta; adivinar, no.' },
        { t: 42, id: 'R-70', txt: 'Multijugador local a pantalla partida.', trampa: 'No cabe, y llega cuando ya no da tiempo. Dejarlo fuera por escrito puntúa más que entregarlo a medias.' },
      ],
    }
  : {
      titulo: 'What the challenge feels like',
      sub: 'Arrows to move, space to jump. Requirements arrive on their own — exactly like the real thing.',
      jugar: 'Click here to play',
      gira: 'Turn your phone: landscape plays much better.',
      tactil: 'Move with ‹ ›, jump with the button on the right.',
      codigo: 'See the code behind this',
      aviso: 'What we measure here',
      reqs: [
        { t: 0, id: 'R-01', txt: 'A character that runs and jumps. It does not fall through the floor.' },
        { t: 12, id: 'R-10', txt: 'Coins: picking them up scores, and the counter is always visible.' },
        { t: 26, id: 'R-30', txt: 'The level must honour the player’s quiet mode.', trampa: 'That term does not exist. Asking, or writing the assumption down, is the answer. Guessing is not.' },
        { t: 42, id: 'R-70', txt: 'Local split-screen multiplayer.', trampa: 'It does not fit, and it lands when there is no time left. Cutting it in writing beats shipping it half-done.' },
      ],
    };
const repo = import.meta.env.PUBLIC_RETO_REPO_URL || '';
---

<section class="not-prose my-10" id="tm-reto">
  <h2 class="text-xl font-semibold mb-1">{copy.titulo}</h2>
  <p class="text-sm text-zinc-600 mb-4">{copy.sub}</p>

  <div class="grid gap-4 md:grid-cols-[1fr_320px]">
    <div class="relative rounded-lg overflow-hidden border border-zinc-300 bg-[#0d1117]">
      <canvas id="tm-canvas" width="640" height="300" class="w-full block" tabindex="0"></canvas>
      <button id="tm-jugar"
        class="absolute inset-0 grid place-items-center bg-black/55 text-white text-sm font-medium">
        {copy.jugar}
      </button>

      {/*
        Mandos para el dedo. La demo se jugaba solo con flechas y espacio, así
        que en un teléfono se veía pero no se podía tocar — y la mitad del
        tráfico de un post de LinkedIn llega desde el móvil.

        Salen solo donde no hay ratón (`@media (pointer: coarse)`), para no
        ensuciar la pantalla de quien sí tiene teclado.
      */}
      <div id="tm-mandos" class="absolute inset-x-0 bottom-0 justify-between p-3 gap-3 hidden">
        <div class="flex gap-3">
          <button type="button" data-tecla="ArrowLeft" aria-label="Izquierda">‹</button>
          <button type="button" data-tecla="ArrowRight" aria-label="Derecha">›</button>
        </div>
        <button type="button" data-tecla=" " aria-label="Saltar" class="saltar">Saltar</button>
      </div>
    </div>

    <p id="tm-tactil" class="text-xs text-zinc-500 m-0 -mt-2">{copy.tactil}</p>
    <p id="tm-gira" class="text-xs text-zinc-500 m-0 -mt-2">{copy.gira}</p>

    <ol id="tm-reqs" class="text-sm space-y-2 m-0 p-0 list-none"></ol>
  </div>

  <p class="text-sm mt-3 flex flex-wrap gap-x-4 gap-y-1">
    {repo && <a href={repo} id="tm-ver-codigo" target="_blank" rel="noopener">{copy.codigo} →</a>}
    <a href={`${Astro.url.pathname.replace(/\/[^/]*$/, '')}/privacy/`} class="text-xs text-zinc-500 self-center">{copy.aviso}</a>
  </p>
</section>

<script is:inline define:vars={{ reqs: copy.reqs, lang }}>
(() => {
  const canvas = document.getElementById('tm-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const lista = document.getElementById('tm-reqs');
  const boton = document.getElementById('tm-jugar');
  // Un solo envío por tipo de evento: medir curiosidad no justifica un goteo
  // de peticiones a cada salto. El envío en sí lo hace el layout, que es quien
  // sabe de qué campaña llegó esta visita.
  const enviados = new Set();
  function track(evento, extra = {}) {
    if (enviados.has(evento)) return;
    enviados.add(evento);
    window.tmTrack?.(evento, { lang, ...extra });
  }

  // Los mismos números que src/motor.lua del armazón.
  const GRAVEDAD = 1800, VELOCIDAD = 260, IMPULSO = 620;
  const W = canvas.width, H = canvas.height;
  const plataformas = [
    { x: 0, y: H - 24, w: W, h: 24 },
    { x: 150, y: H - 110, w: 130, h: 12 },
    { x: 360, y: H - 180, w: 150, h: 12 },
  ];
  const monedas = [{ x: 200, y: H - 140 }, { x: 420, y: H - 210 }, { x: 560, y: H - 60 }];
  const j = { x: 40, y: 40, vx: 0, vy: 0, w: 20, h: 26, enSuelo: false };
  const teclas = {};
  let jugando = false, puntos = 0, saltos = 0, t0 = 0, reloj = 0, abiertos = 0;

  const solapan = (a, b) => a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;

  function paso(dt) {
    j.vx = (teclas.ArrowLeft || teclas.a ? -VELOCIDAD : 0) + (teclas.ArrowRight || teclas.d ? VELOCIDAD : 0);
    if ((teclas[' '] || teclas.ArrowUp || teclas.w) && j.enSuelo) { j.vy = -IMPULSO; j.enSuelo = false; saltos++; }
    j.vy += GRAVEDAD * dt;

    j.x += j.vx * dt;
    for (const p of plataformas) if (solapan(j, p)) j.x = j.vx > 0 ? p.x - j.w : p.x + p.w;
    j.y += j.vy * dt;
    j.enSuelo = false;
    for (const p of plataformas) {
      if (!solapan(j, p)) continue;
      if (j.vy > 0) { j.y = p.y - j.h; j.vy = 0; j.enSuelo = true; } else { j.y = p.y + p.h; j.vy = 0; }
    }
    j.x = Math.max(0, Math.min(W - j.w, j.x));
    if (j.y > H + 150) { j.x = 40; j.y = 40; j.vy = 0; }

    for (const m of monedas) {
      if (!m.tomada && solapan(j, { x: m.x - 7, y: m.y - 7, w: 14, h: 14 })) { m.tomada = true; puntos++; }
    }
  }

  function pintar() {
    ctx.fillStyle = '#0d1117'; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = '#2b3240';
    for (const p of plataformas) ctx.fillRect(p.x, p.y, p.w, p.h);
    ctx.fillStyle = '#e3b341';
    for (const m of monedas) if (!m.tomada) { ctx.beginPath(); ctx.arc(m.x, m.y, 6, 0, 7); ctx.fill(); }
    ctx.fillStyle = '#4f9cf9'; ctx.fillRect(j.x, j.y, j.w, j.h);
    ctx.fillStyle = '#8b98a5'; ctx.font = '13px ui-monospace, monospace';
    ctx.fillText(`${puntos}/${monedas.length}`, 12, 22);
    if (jugando) ctx.fillText(`${Math.floor(reloj)}s`, W - 46, 22);
  }

  function tarjeta(r) {
    const li = document.createElement('li');
    li.className = 'rounded border border-zinc-300 bg-white p-3';
    li.innerHTML = `<div class="font-mono text-xs text-zinc-500">${r.id}</div>
      <div class="mt-1">${r.txt}</div>` +
      (r.trampa ? `<div class="mt-2 text-xs text-amber-700 border-t border-amber-200 pt-2">${r.trampa}</div>` : '');
    li.style.opacity = '0';
    li.style.transform = 'translateY(6px)';
    li.style.transition = 'opacity .35s, transform .35s';
    lista.appendChild(li);
    requestAnimationFrame(() => { li.style.opacity = '1'; li.style.transform = 'none'; });
  }

  let anterior = 0;
  function bucle(ahora) {
    const dt = Math.min(0.05, (ahora - anterior) / 1000 || 0);
    anterior = ahora;
    if (jugando) {
      reloj += dt;
      paso(dt);
      while (abiertos < reqs.length && reqs[abiertos].t <= reloj) tarjeta(reqs[abiertos++]);
      if (puntos === monedas.length) track('reto_demo_completado', { segundos: Math.round(reloj), saltos });
    }
    pintar();
    requestAnimationFrame(bucle);
  }

  function empezar() {
    if (jugando) return;
    jugando = true;
    t0 = Date.now();
    boton.remove();
    canvas.focus();
    track('reto_demo_jugado');
  }

  boton.addEventListener('click', empezar);
  canvas.addEventListener('click', empezar);
  addEventListener('keydown', (e) => {
    teclas[e.key] = true;
    if ([' ', 'ArrowLeft', 'ArrowRight', 'ArrowUp'].includes(e.key) && jugando) e.preventDefault();
  });
  addEventListener('keyup', (e) => { teclas[e.key] = false; });

  // Los mandos táctiles escriben en el mismo `teclas` que el teclado: así el
  // bucle del juego no se entera de por dónde vino la orden y no hay dos
  // caminos que mantener.
  //
  // `pointerdown`/`pointerup` y no `click`: un click llega al soltar, y para
  // correr hace falta saber que el dedo SIGUE puesto. `setPointerCapture` evita
  // que el personaje se quede corriendo si el dedo se desliza fuera del botón.
  const mandos = document.getElementById('tm-mandos');
  mandos?.querySelectorAll('button[data-tecla]').forEach((b) => {
    const tecla = b.dataset.tecla;
    const pulsar = (e) => {
      e.preventDefault();
      if (!jugando) empezar();
      teclas[tecla] = true;
      try { b.setPointerCapture(e.pointerId); } catch {}
    };
    const soltar = () => { teclas[tecla] = false; };
    b.addEventListener('pointerdown', pulsar);
    b.addEventListener('pointerup', soltar);
    b.addEventListener('pointercancel', soltar);
    b.addEventListener('lostpointercapture', soltar);
    // Sin esto, mantener pulsado abre el menú de copiar del móvil encima del juego.
    b.addEventListener('contextmenu', (e) => e.preventDefault());
  });

  // Cuánto aguantó jugando. Se manda al irse, que es cuando se sabe.
  addEventListener('pagehide', () => {
    if (!jugando) return;
    enviados.delete('reto_demo_fin');
    track('reto_demo_fin', { segundos: Math.round((Date.now() - t0) / 1000), saltos, monedas: puntos });
  });

  document.getElementById('tm-ver-codigo')?.addEventListener('click', () => track('reto_codigo_abierto'));
  new IntersectionObserver((e) => { if (e[0].isIntersecting) track('reto_demo_visto'); }, { threshold: 0.4 })
    .observe(canvas);

  tarjeta(reqs[0]); abiertos = 1;
  requestAnimationFrame(bucle);
})();
</script>

<style is:global>
  /* Los mandos aparecen solo donde el puntero es un dedo. En un portátil con
     pantalla táctil manda el ratón, así que no estorban. */
  /*
    Los mandos van DEBAJO del lienzo, no encima.

    Flotando sobre el juego tapaban el suelo y, en un móvil donde el lienzo mide
    167px de alto, se comían la mitad del área jugable: quedaba una franja de
    botones gigantes sobre el personaje. Abajo, en su propia barra, el juego se
    ve entero y el pulgar los tiene igual de cerca.
  */
  @media (pointer: coarse) {
    #tm-mandos {
      display: flex !important;
      position: static;
      border-top: 1px solid #222a35;
      background: #0d1117;
      padding: 8px 10px;
      align-items: center;
    }
  }
  #tm-mandos button {
    min-width: 54px; min-height: 44px;
    display: grid; place-items: center;
    border-radius: 10px; border: 1px solid rgba(255, 255, 255, .25);
    background: rgba(0, 0, 0, .45); color: #fff;
    font: 600 26px/1 system-ui, sans-serif;
    /* El navegador no debe interpretar el gesto: sin esto, arrastrar para
       correr hace scroll de la página y el juego se queda quieto. */
    touch-action: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #tm-mandos button.saltar { font-size: 15px; padding: 0 18px; }
  #tm-mandos button:active { background: rgba(79, 156, 249, .55); }

  /* El lienzo mide 640 de ancho de atributo y así se quedaba: dentro de un
     móvil de 390 hacía que la página entera scrollease en horizontal. Se
     fuerza aquí y no se confía en la clase utilitaria, que es lo que falló. */
  #tm-canvas { width: 100%; height: auto; display: block; }

  /* El lienzo tampoco intercepta gestos: tocarlo para jugar no debe mover la página. */
  @media (pointer: coarse) { #tm-canvas { touch-action: none; } }

  /* En vertical el juego cabe, pero queda del tamaño de un sello. Se dice, no
     se impone: quien quiera jugar así puede, y el aviso se va al girar. */
  /* El subtitulo habla de flechas y espacio, que en un telefono no existen.
     Esta linea lo traduce al dedo, y solo sale donde hace falta. */
  #tm-tactil { display: none; }
  @media (pointer: coarse) { #tm-tactil { display: block; } }

  #tm-gira { display: none; }
  @media (pointer: coarse) and (orientation: portrait) {
    #tm-gira { display: block; }
  }
</style>
