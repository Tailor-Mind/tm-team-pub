---
import Base from '../../layouts/Base.astro';
import RetoDemo from '../../components/RetoDemo.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base lang="en" title="TailorMind — Talent" description="Hiring senior AI-empowered developers, remote from Peru.">
  <h1>Hiring at TailorMind</h1>
  <p class="lead">Remote, from Peru. We pay for the AI tooling you use.</p>
  <p>We hire for <strong>criterio</strong>, the capacity to make sound judgments under uncertainty, and for autonomy with AI tooling.</p>
  <div class="not-prose my-6 grid gap-4 sm:grid-cols-2 text-[15px] leading-relaxed">
    <a href={`${b}/en/product/`} class="block p-4 rounded border border-emerald-300 bg-emerald-50 no-underline text-zinc-900">
      <p class="font-semibold m-0">Product &amp; Quality Analyst · <span class="text-emerald-800">open</span></p>
      <p class="m-0 mt-1">No coding required. 40 hours a week, Peru only. 10-minute application.</p>
    </a>
    <a href={`${b}/en/role/`} class="block p-4 rounded border border-zinc-200 bg-zinc-50 no-underline text-zinc-900">
      <p class="font-semibold m-0">Senior Full-stack Developer · <span class="text-zinc-600">closed</span></p>
      <p class="m-0 mt-1">Applications closed on 26 October. We are reviewing and will reply to every person.</p>
    </a>
  </div>

  <RetoDemo lang="en" />

  <p>Curious about what we build? Have a look at <a href="https://tailormind.io/" target="_blank" rel="noopener">tailormind.io</a>.</p>
  <ul>
    <li><a href={`${b}/en/product/`}>Product &amp; Quality Analyst</a></li>
    <li><a href={`${b}/en/role/`}>Senior Full-stack Developer</a></li>
    <li><a href={`${b}/en/process/`}>How our hiring process works</a></li>
    <li><a href={`${b}/en/flow/`}>Process flow diagram</a></li>
    <li><a href={`${b}/en/assessment/`}>About the assessment</a></li>
    <li><a href={`${b}/en/apply/`}>Apply</a></li>
  </ul>
</Base>
