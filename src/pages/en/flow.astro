---
import Base from '../../layouts/Base.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base lang="en" title="Process flow — TailorMind">
  <h1>Process flow</h1>
  <p>Candidate journey from application to offer. Diagrams render from Mermaid source committed in the repo.</p>

  <h2>Hiring funnel</h2>
  <p><img src={`${b}/img/flows/hiring-funnel.svg`} alt="Hiring funnel: Application → Screening → Take-home (pass/reject) → Tech interview → Offer & negotiation." /></p>

  <h2>Take-home scoring</h2>
  <p><img src={`${b}/img/flows/scoring.svg`} alt="Take-home scoring flow: Criterio score + Autonomy score + Tech score → pass/reject." /></p>

  <details>
    <summary>Mermaid source</summary>
    <pre><code class="language-mermaid">{`flowchart LR
  A[Application] --> B[Screening]
  B -->|pass| C[Take-home]
  B -->|reject| X1[Polite reject]
  C -->|pass| D[Tech interview]
  C -->|reject| X2[Polite reject]
  D --> E[Offer & negotiation]
  D -->|no fit| X3[Polite reject]
`}</code></pre>
  </details>
</Base>
